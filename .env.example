# Copy to .env (next to server.js) and edit, or set these as environment variables of the Windows service. Never commit .env.
NODE_ENV=production
PORT=3000

# REQUIRED in production. One or more keys, comma separated. Give each client (app / website) its own key.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_KEYS=change-me-key-for-mobile-app,change-me-key-for-website

# Timezone used to read/return timestamps that carry a "Z"/offset or are epoch numbers
TZ=Asia/Kolkata

# Web front-ends only (mobile apps do not need CORS). Comma separated origins. Empty = no browser access.
CORS_ORIGINS=https://your-website.com

# Limits
RATE_LIMIT_PER_MIN=60        # per API key
MAX_POINTS=200000            # per request (send one vehicle-day at a time)
MAX_BODY_MB=25
MAX_CONCURRENT=2             # analyses running at once (each uses one CPU core)
MAX_QUEUE=20                 # more may wait; beyond this the API answers 503
JOB_TIMEOUT_SECONDS=120

# Behind IIS (ARR) / a load balancer: number of proxies in front (so rate limits see the real client IP)
TRUST_PROXY=1

# Test page at "/" (map uploader). Keep off in production.
SERVE_TEST_PAGE=false

# MySQL - needed for requests that send deviceId/fromDate/toDate (data comes from usp_history_replay).
# Same format as the .NET connection string. A new connection is opened per request and closed afterwards.
DB_CONNECTION_STRING=Server=127.0.0.1;Database=db_global_tracking;User ID=your-user;Password=your-password;Port=3306;SslMode=None;pooling=false;
