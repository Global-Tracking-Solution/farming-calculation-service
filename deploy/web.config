<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS reverse proxy -> Node (server.js running as a Windows service on port 3001).
  Put this file ALONE in the IIS site folder (e.g. C:\inetpub\farming-api), not in the app folder.
  Needs the IIS "URL Rewrite" and "Application Request Routing" modules, with ARR proxy enabled.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="ProxyToNode" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3001/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <!-- 26 MB: a bit above MAX_BODY_MB=25 so Node returns its own JSON error -->
        <requestLimits maxAllowedContentLength="27262976" />
      </requestFiltering>
    </security>
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
